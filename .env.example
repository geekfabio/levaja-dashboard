# Copiar para .env.local (não vai para o git). Só variáveis NEXT_PUBLIC_* chegam ao navegador.

# URL base da API (sem /api no fim; a API não tem prefixo). Em desenvolvimento, localhost:3000 e
# localhost:4000 são o mesmo "site" para o cookie de sessão do painel (SameSite=Strict).
NEXT_PUBLIC_API_URL=http://localhost:4000

# O CRM comercial ainda não lê da API: continua com dados de demonstração. Só mudar para "http"
# depois de cada módulo do CRM ler da API.
NEXT_PUBLIC_CRM_DATA_SOURCE=mock

# Mapa do painel. Os servidores públicos servem só para desenvolvimento; em produção, usar os próprios.
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org
