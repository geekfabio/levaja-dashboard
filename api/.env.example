# Copiar para .env (não vai para o git).

# Connection string Neon (HTTP, obrigatório; a ligação directa por TCP não é usada).
DATABASE_URL=

# Schema Postgres isolado desta API dentro da base de dados partilhada.
DB_SCHEMA=angoleva

PORT=4000

# Segredos para assinar os tokens (gerar com `openssl rand -base64 48`).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duração do token de acesso da app móvel, em segundos.
JWT_ACCESS_TTL_SECONDS=900

# Duração do refresh token da app móvel, em dias.
JWT_REFRESH_TTL_DAYS=30

# Segredo da sessão do painel (cookie assinado).
ADMIN_SESSION_SECRET=

# Duração da sessão do painel, em horas.
ADMIN_SESSION_TTL_HOURS=12

# Origens permitidas para CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Envio real de email (códigos OTP). Sem fornecedor ligado ainda (ver Fase 9);
# por omissão (vazio ou "false") os códigos só ficam no log do servidor.
EMAIL_LIVE=false
